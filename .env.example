TOKEN=''
ICON_TOKEN=''

# Telegram user ID allowed to run /status (all users' broker connectors).
# ADMIN_ID='123456789'

# EYRI_DATABASE_PATH='data/eyri.sqlite'
# Optional Yahoo listing overrides for /chart (native ticker:currency).
# EYRI_YAHOO_SYMBOLS='{"2DGD_EQ:EUR":"2DG.F"}'

# Optional options-only historical fallback after Yahoo fails.
# DATABENTO_API_KEY=''

# IBKR Flex credentials are stored per user with:
# /ibkr [instance_url] [flex_token] [flex_query_id]
FLEX_MAX_YEARS='5'

# MCP HTTP endpoint alongside the bot (0 disables HTTP).
# EYRI_MCP_HOST='127.0.0.1'
# EYRI_MCP_PORT='8000'

# Eyri Web dashboard (0 disables Web UI).
# EYRI_WEB_HOST='127.0.0.1'
# EYRI_WEB_PORT='3000'
# Public HTTPS URL (used for Secure cookies and origin validation).
# EYRI_WEB_URL='https://eyri.mercat-pumpkinseed.ts.net'
# Optional bot username override for Telegram Login Widget (auto-detected from TOKEN when omitted).
# EYRI_WEB_BOT_USERNAME='YourEyriBot'
# Optional comma-separated Telegram user ID allowlist (existing /start users only when omitted).
# EYRI_WEB_ALLOWED_USERS='123456789'
# Local testing only: bypass Telegram OAuth and act as the given Telegram user ID.
# FORCE_USER='123456789'
